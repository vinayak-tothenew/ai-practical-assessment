{
  "name": "support-ticket-backend",
  "version": "1.0.0",
  "description": "Backend database foundation for the Support Ticket Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:init": "tsx src/db/init.ts",
    "db:verify": "tsx src/db/verify.ts",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --watch"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
